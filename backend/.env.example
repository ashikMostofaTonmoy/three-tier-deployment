# Copied to .env on the server by scripts/deploy-backend.sh — not used in git.
PORT=3000
NODE_ENV=production

# Postgres runs on the SAME machine as this backend (single-VM three-tier lab),
# so the host is always "localhost".
DATABASE_URL=postgresql://three_tier_user:changeme@localhost:5432/three_tier

# How many PM2 workers to run in cluster mode. 2 is enough to prove zero-downtime
# reloads (>=1 worker always serving) without using too much of a t3.small's RAM.
PM2_INSTANCES=2

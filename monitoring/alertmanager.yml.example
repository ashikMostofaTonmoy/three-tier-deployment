# Alertmanager's config: what to do with an alert Prometheus hands it.
# Prometheus decides WHAT is wrong (the rule fired); Alertmanager decides
# WHO to tell and HOW OFTEN to remind them — grouping, deduplication, and
# routing live here, not in Prometheus.
#
# This file is committed with a PLACEHOLDER webhook URL on purpose — the
# stack runs correctly either way. scripts/deploy-monitoring.sh substitutes
# a real Slack URL if you pass one; if you don't, alerts still fire and show
# up in Prometheus's and Alertmanager's own UIs, they just fail to actually
# reach Slack (see README §37 for how to mint a real webhook URL).
#
# The placeholder below MUST be a well-formed URL (scheme + host), not just
# a token — Alertmanager validates the URL's syntax when it STARTS UP, not
# only when it tries to send. An invalid/schemeless placeholder makes the
# whole service refuse to boot, not just fail to deliver.

global:
  resolve_timeout: 5m

route:
  receiver: slack
  group_by: ["alertname"]
  group_wait: 10s        # wait a little to bundle related alerts together
  group_interval: 5m     # how often to send updates for an already-open group
  repeat_interval: 3h    # don't re-notify about the same firing alert more than this often

receivers:
  - name: slack
    slack_configs:
      - api_url: "https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER"
        channel: "#alerts"
        send_resolved: true
        title: "{{ .CommonAnnotations.summary }}"
        text: "{{ .CommonAnnotations.description }}"
